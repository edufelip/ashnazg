{
  "jsonrpc": "2.0",
  "id": 2,
  "result": {
    "tools": [
      {
        "name": "app_install",
        "description": "Install an APK on the selected Android session; optionally launch the package.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "launch": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "package": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        },
        "annotations": {
          "destructiveHint": true
        }
      },
      {
        "name": "app_logs",
        "description": "Return bounded Android agent log lines.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "sinceMs": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tagFilter": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "ui_act",
        "description": "Perform a validated action on the Android UI and return a fresh snapshot.",
        "inputSchema": {
          "$defs": {
            "Action": {
              "enum": [
                "tap",
                "long_press",
                "type",
                "clear",
                "scroll_to",
                "back",
                "deep_link"
              ],
              "type": "string"
            },
            "Direction": {
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ],
              "type": "string"
            },
            "Target": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "snapshotId": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "testId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/Action"
            },
            "direction": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Direction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Target"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        },
        "annotations": {
          "destructiveHint": true
        }
      },
      {
        "name": "ui_screenshot",
        "description": "Capture a guest screenshot; returns both screenshot image content and metadata.",
        "inputSchema": {
          "$defs": {
            "ScreenshotFormat": {
              "enum": [
                "webp",
                "png"
              ],
              "type": "string"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "format": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScreenshotFormat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "somOverlay": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "annotations": {
          "readOnlyHint": true
        }
      },
      {
        "name": "ui_snapshot",
        "description": "Return the current semantic Android UI snapshot.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "includeInvisible": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        },
        "annotations": {
          "readOnlyHint": true
        }
      }
    ]
  }
}
